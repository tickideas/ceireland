{
  "name": "ceireland",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:typecheck && find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "postinstall": "prisma generate --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:generate": "prisma generate --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:migrate": "prisma migrate dev --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:migrate:create": "prisma migrate dev --create-only --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate --schema ${PRISMA_SCHEMA:-prisma/schema.prisma} && prisma migrate deploy --schema ${PRISMA_SCHEMA:-prisma/schema.prisma} && tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:status": "prisma migrate status --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.1",
    "hls.js": "^1.7.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "recharts": "^3.10.1",
    "usesend-js": "^1.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.25",
    "brace-expansion@^1.0.0": "1.1.18",
    "browserslist": "4.29.0",
    "deepmerge-ts": "8.0.0",
    "js-yaml": "4.3.2",
    "mysql2": "3.23.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "reselect": "5.3.0",
    "sharp": "0.35.4",
    "undici": "7.29.0"
  }
}

{
  "name": "ceireland",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "postinstall": "prisma generate --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:generate": "prisma generate --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:migrate": "prisma migrate dev --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:migrate:create": "prisma migrate dev --create-only --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate --schema ${PRISMA_SCHEMA:-prisma/schema.prisma} && prisma migrate deploy --schema ${PRISMA_SCHEMA:-prisma/schema.prisma} && tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}",
    "db:status": "prisma migrate status --schema ${PRISMA_SCHEMA:-prisma/schema.prisma}"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.6.0",
    "@prisma/client": "^6.6.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "dotenv": "^17.3.1",
    "hls.js": "^1.6.15",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^19.0.2",
    "recharts": "^3.8.0",
    "usesend-js": "^1.6.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "reselect": "5.1.0",
    "undici": "7.28.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
